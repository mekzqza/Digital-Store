# The store's address. Its DNS A record must already point at this server, and ports 80 + 443 must be open.
DOMAIN=shop.example.com

# The admin account: sign in at /admin/login. Re-applied on every start, so change the password here.
# Wrap the password in 'single quotes' if it contains $ or #.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PK=pk_test_...
# Stripe Dashboard → Developers → Webhooks → endpoint https://<DOMAIN>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# optional: "continue with Google" (OAuth client ID, type "Web application"). Leave empty to hide the button.
GOOGLE_CLIENT_ID=

# optional, but needed for email verification: the shop's Gmail account. It sends the link a new customer must
# click before their account opens, and a receipt after every successful payment. Leave empty to send nothing:
# registering then opens the account straight away, unverified.
# The password is a 16-letter "app password", not the account's own: turn on 2-Step Verification,
# then create one at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# local dev only (compose sets these itself)
DATABASE_URL=postgres://shop:change-me@localhost:5432/shop
UPLOAD_DIR=./uploads
